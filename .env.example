# ---- الزامی ----
BOT_TOKEN=
OWNER_ID=

# ---- کلید رمزنگاری نشست‌ها (install.sh خودش می‌سازه؛ گم بشه همه نشست‌ها از بین می‌رن) ----
SESSION_KEY=

# ---- پیشنهادی ----
# API_ID / API_HASH خودت رو از my.telegram.org بگیر
API_ID=
API_HASH=
# آدرس عمومی داشبورد (پشت HTTPS): https://panel.example.com
WEB_BASE_URL=
# فقط پشت reverse proxy خودت روشن کن
TRUST_PROXY=0
OPEN_ACCESS=1
MAX_USERS=500

# ---- پورت روی هاست (داخل کانتینر همیشه 8787) ----
HOST_PORT=8787
MEM_LIMIT=768m
CPU_LIMIT=1.5
