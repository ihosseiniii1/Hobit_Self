
# =====================================================================
#  PR GRAM Helper - .env
#  Lines starting with # are comments. Empty value = default is used.
# =====================================================================

# ---------- REQUIRED ----------
# Token of the control bot (from @BotFather)
BOT_TOKEN=9126201003:AAE7YaN-YKR-vd6rvNeX5FNrvkF9x6MnMbs
# Your numeric Telegram user id (the owner, full access). Get it from @userinfobot
OWNER_ID=338266658

# ---------- Telegram API (recommended: your OWN, from https://my.telegram.org) ----------
API_ID=32359873
API_HASH=c9e09b5bac48db8c32eb3f3f5080dfac

# ---------- Access ----------
# Other admins (numeric ids, comma separated). Optional: you can also manage admins in the Owner panel.
ADMIN_IDS=338266658
# 1 = everyone may use the bot, 0 = invite-only (use /allow ID)
OPEN_ACCESS=1
# Maximum number of registered users
MAX_USERS=500
# Telegram requests running at the same time across ALL accounts
GLOBAL_CONC=60

# ---------- Security ----------
# Key that encrypts the saved Telegram sessions. Empty = generated once and saved in data/secret.key
SESSION_KEY=
# Secret that signs the dashboard links. Empty = generated once and saved in data/web_secret.key
WEB_SECRET=
# Master (owner) dashboard token. Empty = generated once and saved in data/web_token.txt
WEB_TOKEN=

# ---------- Web dashboard ----------
# Public address of the dashboard, used for the "Open dashboard" button in Telegram.
# Examples: http://1.2.3.4:8787   or   https://panel.example.com
WEB_BASE_URL=
# Port of the dashboard. Empty = auto (host-assigned port, otherwise 8787-8811)
WEB_PORT=
# 1 only if you run behind your own reverse proxy (nginx/caddy) so X-Forwarded-For can be trusted
TRUST_PROXY=0

# ---------- Proxy (only if Telegram is blocked on your server) ----------
USE_PROXY=0
PROXY_URL=socks5://127.0.0.1:1080

# ---------- PR GRAM bot ----------
PG_BOT=gram_piarbot
# Text sent to open the earnings menu
PG_EARN_TEXT=Earnings
# Menu buttons (matched by text, the counts like "· 422" are ignored)
PG_CATEGORY=Channels
PG_GROUP_CATEGORY=Groups
PG_VIEWS_CATEGORY=Views
# Mirror bot used for Views when the main bot rate-limits
PG_MIRROR=gram_prbot

# ---------- Human mode (patch 3.8) ----------
# The helper picks a random hourly join limit between these two numbers and re-rolls it about every hour
HOUR_CAP_MIN=45
HOUR_CAP_MAX=90

# ---------- Fine tuning (leave as is unless you know why) ----------
PG_FETCH_INTERVAL=3
PG_JOIN_INTERVAL=8
PG_CONC=3
PG_BATCH=10
PG_MAX_PAGES=25
# Accounts handled at the same moment by the scheduler
TICK_CONC=48
TICK_BURST=200
# Bot messages / edits per second (Bot API allows ~30)
BOT_RATE=25
# Country code added when a user types a phone number starting with 0 (98 = Iran)
DEFAULT_COUNTRY_CODE=98
# 1 = the first person who sends /start becomes owner (NOT recommended, use OWNER_ID)
ALLOW_FIRST_OWNER=0







